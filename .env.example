# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN credentials (defaults shown — override in production)
ADMIN_USERNAME=VinayMathad
ADMIN_PASSWORD=Vinay@admin

# SMTP Configuration (Optional, for email notifications when support forms are submitted)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@getshaadilink.in
SMTP_PASS=your_email_account_password_here

# DATA_PATH: Absolute path to the data/ folder on the server.
# Set this in Hostinger's environment variables panel to the exact path of your data/ folder.
# Example: DATA_PATH=/home/username/getshaadilink/data
# If not set, the server auto-resolves to: (script location)/../data
DATA_PATH=

# NODE_ENV: Set to "production" on Hostinger
NODE_ENV=production
