# GetShaadiLink Production Environment Configuration
# Add these variables in the Hostinger hPanel Node.js dashboard, or rename this file to .env:

GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000
NODE_ENV=production

# SMTP Configuration (Optional, for email notifications when support forms are submitted)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@getshaadilink.in
SMTP_PASS=your_email_account_password_here
